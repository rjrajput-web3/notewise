# Notewise — optional overrides.
# The app already ships with the live Firebase project config in
# src/firebase-config.js, so you do NOT need a .env file to run it.
# Copy this to .env only if you want to point the app at a different project.
#
# Get these values from the Firebase console:
# Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA Enterprise site key for App Check in production.
# Without it, the app runs App Check in debug-token mode during development.
VITE_APPCHECK_SITE_KEY=

# LLM fallback proxy (api/llm.js) — server-side keys only, NEVER in client
# code. Each tier is skipped when its key is absent.
# OpenRouter :free models: create a key at openrouter.ai (free, no card).
# Leave empty until the key is available — the tier skips gracefully.
OPENROUTER_API_KEY=
# Groq: create a key at console.groq.com (free tier). Leave empty until the
# user supplies one — the tier skips gracefully. Never hardcode a key.
GROQ_API_KEY=
# NOTE: GitHub Models is RETIRED (GitHub shut it down 2026-07-30;
# models.github.ai returns a bare "OK" stub). Do NOT add a token for it.
