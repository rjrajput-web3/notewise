# Notewise — optional overrides.
# The app already ships with the live Firebase project config in
# src/firebase-config.js, so you do NOT need a .env file to run it.
# Copy this to .env only if you want to point the app at a different project.
#
# Get these values from the Firebase console:
# Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA Enterprise site key for App Check in production.
# Without it, the app runs App Check in debug-token mode during development.
VITE_APPCHECK_SITE_KEY=
